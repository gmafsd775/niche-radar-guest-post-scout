    {
      "parameters": {
        "jsCode": "const raw = items[0].json.output || \"\";\n\n// Step 1: Extract the JSON block using regex\nconst match = raw.match(/```json\\s*([\\s\\S]*?)\\s*```/);\nif (!match || !match[1]) {\n  return [{\n    json: {\n      error: \"No valid JSON block found in AI output\",\n      preview: raw.slice(0, 300)\n    }\n  }];\n}\n\nconst cleaned = match[1].trim();\n\n// Step 2: Parse the JSON safely\nlet parsed;\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (err) {\n  return [{\n    json: {\n      error: \"Failed to parse extracted JSON\",\n      message: err.message,\n      preview: cleaned.slice(0, 300)\n    }\n  }];\n}\n\n// Step 3: Validate it's an array\nif (!Array.isArray(parsed)) {\n  return [{\n    json: {\n      error: \"Parsed data is not an array\",\n      type: typeof parsed,\n      raw: parsed\n    }\n  }];\n}\n\n// Step 4: Normalize each entry\nreturn parsed.map((entry, index) => ({\n  json: {\n    index,\n    website: entry.website || \"(missing)\",\n    domain_rating: entry.domain_rating || \"(missing)\",\n    domain_authority: entry.domain_authority || \"(missing)\",\n    url: entry.url || \"(missing)\",\n    email: entry.email || \"(missing)\",\n    phone: entry.phone || \"(missing)\",\n    traffic: entry.traffic || \"(missing)\"\n  }\n}));\n"
      },
